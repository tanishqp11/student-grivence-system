# ----------------------------------------------------------------------------
# Copy this file to `.env` for local development (never commit `.env`).
# On Vercel add the same variables under Project -> Settings -> Environment Variables.
# ----------------------------------------------------------------------------

# Postgres connection string (Neon, Supabase, Railway, or any hosted Postgres).
# Example: postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Secret used to sign login session cookies. Use any long random string.
AUTH_SECRET=change-this-to-a-long-random-string

# Seed administrator account created by `npm run db:init`.
ADMIN_EMAIL=admin@university.edu
ADMIN_PASSWORD=Admin@123

# Set to 1 on Vercel so cookies are marked Secure (HTTPS only).
NODE_ENV=development
